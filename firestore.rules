rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() in ['ADMIN', 'Admin', 'admin'] ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@ramkrishnapuram.com' ||
          request.auth.token.email.matches('(?i).*admin.*')
        ))
      );
    }

    function isResident() {
      return isAuthenticated() && getUserRole() in ['RESIDENT', 'Resident', 'resident'];
    }
    
    function isGuard() {
      return isAuthenticated() && getUserRole() in ['GUARD', 'Guard', 'guard'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || isGuard() || (isAuthenticated() && (
        request.auth.uid == userId ||
        (resource.data != null && resource.data.uid == request.auth.uid) ||
        (request.auth.token.email != null && resource.data != null && resource.data.email == request.auth.token.email) ||
        (request.auth.token.email != null && resource.data != null && resource.data.username == request.auth.token.email) ||
        (request.auth.token.phone_number != null && resource.data != null && resource.data.phone == request.auth.token.phone_number)
      ));
      allow create: if isAdmin() || (isAuthenticated() 
                    && request.auth.uid == userId 
                    && request.resource.data.role == 'RESIDENT'
                    && request.resource.data.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && (
        // Standard: doc ID matches auth uid
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        // Resident found via email/username — allow updating uid + contact fields only
        (
          resource.data != null &&
          request.resource.data.role == resource.data.role &&
          (
            (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
            (request.auth.token.email != null && resource.data.username == request.auth.token.email) ||
            resource.data.uid == request.auth.uid
          )
        )
      ));
      allow delete: if isAdmin();
    }

    match /flats/{flatId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /maintenance_dues/{dueId} {
      allow read: if isAuthenticated();
      allow delete: if isAdmin();

      // Allow admins full create access.
      // Allow authenticated residents to create advance/early bills when submitting for approval
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.status == 'PAYMENT_PENDING_APPROVAL'
      );

      // Allow admins full update access.
      // Allow authenticated residents to update dues when submitting payment for approval
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.status == 'PAYMENT_PENDING_APPROVAL'
      );
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read, write: if isAdmin();
      allow read: if isResident() && resource.data.residentUid == request.auth.uid;
      allow create: if isResident() && request.resource.data.residentUid == request.auth.uid;
    }

    match /visitors/{visitorId} {
      allow read, write: if isAdmin();
      allow read, create, update: if isAuthenticated();
    }

    match /gate_parcels/{parcelId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isGuard();
      allow delete: if isAdmin();
    }

    match /security_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isGuard();
      allow update, delete: if isAdmin();
    }
    
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isResident() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isAdmin() || (isResident() && resource.data.authorUid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data != null && (
          resource.data.targetUid == request.auth.uid ||
          (resource.data.targetUids != null && request.auth.uid in resource.data.targetUids)
        ))
      );
    }

    // Society Accounts & Budget Management Rules
    match /society_annual_budgets/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /society_budget_heads/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /society_budget_revisions/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /society_transactions/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
  }
}
